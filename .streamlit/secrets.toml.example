# DSLQ RU App - Streamlit Secrets Template
#
# Copy this file to .streamlit/secrets.toml for local development.
# Never commit the real secrets.toml file.
#
# In Streamlit Community Cloud, paste these values into:
# Settings -> Secrets

[supabase]
url = "your_supabase_url"
key = "your_supabase_anon_or_service_key"

# Recommended for the Russian app: keep tables separate from the English app.
sessions_table = "dslq_ru_sessions"
contacts_table = "dslq_ru_contacts"
